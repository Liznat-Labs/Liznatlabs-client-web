# Copy this to .deploy.env and fill in your values.
# .deploy.env is gitignored — never commit it.

EC2_HOST=13.233.45.67        # Your EC2 public IP
EC2_USER=ec2-user             # ec2-user (Amazon Linux) or ubuntu (Ubuntu)
EC2_KEY=~/.ssh/liznat-key.pem # Path to your .pem key file
APP_DIR=/opt/liznat-labs       # Where the repo lives on EC2
