{
  "connector": {
    "name": "local"
  },
  "hints": {
    "no-inline-styles": "off",
    "css-prefix-order": "off",
    "compat-api/css": "off",
    "axe/aria": "off",
    "axe/color-contrast": "off",
    "axe/forms": "off",
    "axe/keyboard": "off",
    "axe/language": "off",
    "axe/name-role-value": "off",
    "axe/parsing": "off",
    "axe/semantics": "off",
    "axe/sensory-and-visual-cues": "off",
    "axe/structure": "off",
    "axe/tables": "off",
    "axe/text-alternatives": "off",
    "axe/time-and-media": "off",
    "content-type": "off",
    "no-bom": "off",
    "no-protocol-relative-urls": "off",
    "stylesheet-limits": "off",
    "x-content-type-options": "off"
  },
  "parsers": ["css", "javascript", "typescript"]
}
